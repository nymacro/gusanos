Import('env')

if not env['NO_PARSERS']:
	env.Parser('omfg_script_parser.h', 'omfg_script_parser.pg')
env.StaticLibrary(env.getLibName('omfgscript'), env.getObjects())

# Build OmfgScript tests alongside the library for debug builds.
# Goop/base_action.cpp is compiled into the test build dir via the test env
# (lambda) so the source tree stays clean of object files.
env.TestProgram('omfgscript_tests', ['omfgscript', 'omfgutil'],
		extra_sources=lambda te: [te.Object(
			'tests/.build/' + te['MY_SUBFOLDER'] + '/base_action.o',
			'#Goop/base_action.cpp')])
